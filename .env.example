# ChatModel — 标注和摘要共用
CHAT_MODEL_API_KEY=sk-your-chat-api-key
CHAT_MODEL_BASE_URL=https://api.openai.com/v1
CHAT_MODEL_NAME=gpt-4o

# Embedding — 语义去重（可选，不配置则仅用标题/链接精确去重）
EMBEDDING_API_KEY=sk-your-embedding-api-key
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL_NAME=text-embedding-3-small

# QQ 主动推送目标 openid（scripts/qq_push.mjs 使用；本文件勿填真实值）
QQ_TARGET_OPENID=your-qq-user-openid

# HTTP Proxy for RSS feeds (optional)
PROXY_ADDR=http://127.0.0.1:7890
